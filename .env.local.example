# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real credentials.

# Used by NextAuth to sign session tokens (already required, generate with: openssl rand -base64 32)
AUTH_SECRET=

# Gmail SMTP for outgoing notification emails (optional — app works fine without these,
# email sending is a no-op with a console warning if unset).
# 1. Enable 2-Step Verification on the Google account: https://myaccount.google.com/security
# 2. Generate an App Password: https://myaccount.google.com/apppasswords
GMAIL_USER=
GMAIL_APP_PASSWORD=
